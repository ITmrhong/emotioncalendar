<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EmotionCalendarDiary.Views.CalendarPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmotionCalendarDiary.ViewModels"
    xmlns:conv="clr-namespace:EmotionCalendarDiary.Converters"
    x:DataType="vm:CalendarViewModel"
    Title="감정 달력">

    <ContentPage.Resources>
        <conv:BoolToOpacityConverter x:Key="InCurrentMonthOpacityConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Text="◀" Command="{Binding PreviousMonthCommand}" WidthRequest="48" />
            <Label Grid.Column="1" Text="{Binding CurrentMonth, StringFormat='{0:yyyy년 M월}'}"
                   FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" WidthRequest="48" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
            <Label Grid.Column="0" Text="일" HorizontalOptions="Center" TextColor="Red" />
            <Label Grid.Column="1" Text="월" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="화" HorizontalOptions="Center" />
            <Label Grid.Column="3" Text="수" HorizontalOptions="Center" />
            <Label Grid.Column="4" Text="목" HorizontalOptions="Center" />
            <Label Grid.Column="5" Text="금" HorizontalOptions="Center" />
            <Label Grid.Column="6" Text="토" HorizontalOptions="Center" TextColor="Blue" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Days}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDayCellViewModel">
                    <Border Margin="2" Padding="2" HeightRequest="56"
                            Opacity="{Binding IsInCurrentMonth, Converter={StaticResource InCurrentMonthOpacityConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectDayCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding DayNumber}" HorizontalOptions="Center" FontSize="14" />
                            <Label Text="{Binding EmojiStamp}" HorizontalOptions="Center" FontSize="20" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
